# 复制到 /etc/rag-arch-demo/rag-arch.env 后逐项替换。此示例中的凭据均为占位值。
# 实际文件只允许服务账号读取，不要提交真实环境文件。
RAG_ARCH_DATABASE_URL=postgresql://rag_arch_demo@127.0.0.1:5432/rag_arch_demo
RAG_ARCH_DATABASE_SCHEMA=rag_arch_demo
PGPASSFILE=/etc/rag-arch-demo/app.pgpass

# 前端与 API 共用一个 HTTPS origin；API 不托管 React 文件。
RAG_ARCH_SERVE_FRONTEND=false
RAG_ARCH_AUTH_COOKIE_SECURE=true
RAG_ARCH_AUTH_COOKIE_SAMESITE=lax
RAG_ARCH_AUTH_TRUSTED_PROXIES=127.0.0.1
RAG_ARCH_AUTH_ALLOWED_ORIGINS=https://rag-arch-demo.example.com
RAG_ARCH_FRONTEND_ORIGINS=https://rag-arch-demo.example.com

# 每个 worker 的本地执行线程上限；数据库中的全站上限另行设置。
RAG_ARCH_WORKER_CONCURRENCY=3
RAG_ARCH_TASK_TIMEOUT_SECONDS=3600
RAG_ARCH_CORE_VECTOR_BACKEND=binary
RAG_ARCH_PDF_TIMEOUT_SECONDS=120
RAG_ARCH_PDF_TEMP_DIR=/opt/rag-arch-demo/data/runtime/pdf_tmp

# 模型凭据由密钥管理流程提供。替换所有 CHANGE_ME；不要把真实凭据写入仓库。
RAG_CHAT_BASE_URL=https://api.example.invalid/v1
RAG_CHAT_MODEL=YOUR_CHAT_MODEL
RAG_CHAT_API_KEY=CHANGE_ME_CHAT_KEY
RAG_CHAT_API_PROTOCOL=auto
RAG_EMBEDDING_BASE_URL=https://api.example.invalid/v1
RAG_EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
RAG_EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_KEY
RAG_RERANKER_PROVIDER=bailian
RAG_RERANKER_MODEL=YOUR_RERANKER_MODEL
# 留空时沿用聊天供应商密钥；独立密钥时替换为密钥管理器提供的值。
RAG_RERANKER_API_KEY=
