# Main React/FastAPI workflows require your model-service configuration and reference corpus.
# The offline CLI sample does not read this file or call model services.
# Chat Completions compatible endpoint; replace all placeholder values.
RAG_USE_TOKENPLAN=false
RAG_CHAT_API_PROTOCOL=chat_completions
RAG_CHAT_MODEL=YOUR_TOOL_CALLING_MODEL
RAG_CHAT_BASE_URL=https://YOUR_PROVIDER_HOST/v1
RAG_CHAT_API_KEY=YOUR_CHAT_API_KEY
RAG_CHAT_MAX_TOKENS=8192
RAG_CHAT_CONTEXT_BUDGET_TOKENS=65536
RAG_CHAT_THINKING_BUDGET=
RAG_CHAT_TIMEOUT_SECONDS=120
RAG_CHAT_WEB_SEARCH_ENABLED=false
RAG_CHAT_WEB_EXTRACTOR_ENABLED=false
RAG_CHAT_CODE_INTERPRETER_ENABLED=false
# Embeddings must use a provider/model supporting the original adapter.
RAG_EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
RAG_EMBEDDING_BASE_URL=https://YOUR_PROVIDER_HOST/v1
RAG_EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_DIMENSIONS=1024
# Original cloud reranker adapter supports Bailian; use your own endpoint/key.
RAG_RERANKER_PROVIDER=bailian
RAG_RERANKER_MODEL=qwen3-rerank
RAG_RERANKER_BASE_URL=https://YOUR_RERANK_PROVIDER_HOST
RAG_RERANKER_API_KEY=YOUR_RERANKER_API_KEY
RAG_RERANKER_DEFAULT_ENABLED=true
RAG_TIMEOUT_SECONDS=120
RAG_PLAN_MAX_TOKENS=8192
RAG_PLAN_CONTEXT_BUDGET_TOKENS=65536
RAG_PLAN_THINKING_BUDGET=
RAG_PLAN_TIMEOUT_SECONDS=120

# Web deployment variables are read from the PROCESS ENVIRONMENT, not this dotenv file.
# Export them as described in docs/setup.md. Never commit real database credentials.
# RAG_ARCH_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/YOUR_DATABASE
# RAG_ARCH_AUTH_COOKIE_SECURE=false  # Local HTTP only; use true behind HTTPS.
